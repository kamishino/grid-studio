{
  "primitive": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        }
      },
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": "0.78rem"
        },
        "sm": {
          "$type": "dimension",
          "$value": "0.86rem"
        },
        "md": {
          "$type": "dimension",
          "$value": "1rem"
        },
        "lg": {
          "$type": "dimension",
          "$value": "1.45rem"
        }
      },
      "weight": {
        "bold": {
          "$type": "fontWeight",
          "$value": "700"
        },
        "strong": {
          "$type": "fontWeight",
          "$value": "750"
        },
        "heavy": {
          "$type": "fontWeight",
          "$value": "800"
        }
      }
    }
  }
}
